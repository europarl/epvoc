<https://data.europarl.europa.eu/def/epvoc#> a owl:Ontology, adms:Asset;
  dcterms:title "EPVOC ontology"@en;
  dcterms:description "The EPVOC ontology defines classes and properties that are re-used across ontologies, vocabularies, and application profiles to represent data of the European Parliament."@en;
  dcterms:created "2022-11-18"^^xsd:date;
  dcterms:modified "2026-05-12"^^xsd:date;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
  dcterms:type <http://publications.europa.eu/resource/authority/dataset-type/ONTOLOGY>;
  owl:versionInfo "3.1.0";
  dcterms:conformsTo <https://www.w3.org/2002/07/owl>;
  dcterms:creator <http://publications.europa.eu/resource/dataset/corporate-body/EP>;
  dcterms:publisher <http://publications.europa.eu/resource/dataset/corporate-body/EP>;
  dcterms:rightsHolder <http://publications.europa.eu/resource/dataset/corporate-body/EURUN>;
  dcterms:dateCopyrighted "2022"^^xsd:gYear;
  owl:versionIRI <https://data.europarl.europa.eu/def/epvoc#>;
  adms:status <http://publications.europa.eu/resource/dataset/dataset-status/DEVELOP>;
  foaf:logo <https://www.europarl.europa.eu/portal/img/ep-logo.svg>;
  vann:preferredNamespaceUri <https://data.europarl.europa.eu/def/epvoc#>;
  vann:preferredNamespacePrefix "epvoc" .

epvoc:CapacityRole a owl:Class;
  owl:versionInfo "3.0.0";
  owl:deprecated "false";
  rdfs:label "capacity role"@en;
  rdfs:comment "Defines the role or function of a person in a specific capacity."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:ContactPoint a owl:Class;
  owl:versionInfo "1.0.0";
  rdfs:subClassOf vcard:Address;
  owl:deprecated "false";
  epvoc:scAlignement <https://schema.org/ContactPoint>;
  rdfs:label "contact point"@en;
  rdfs:comment "Identifies a contact point for a person or organisation."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:ForeseenCapacity a owl:Class;
  owl:versionInfo "3.0.0";
  rdfs:subClassOf eli-dl:Participation;
  owl:deprecated "false";
  rdfs:label "foreseen capacity"@en;
  rdfs:comment "Indicates the expected capacity of a person, room, or resource."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:Room a owl:Class;
  owl:versionInfo "1.0.0";
  owl:deprecated "false";
  rdfs:label "room"@en;
  rdfs:comment "Identifies a physical or virtual room, e.g., a meeting room or a person's office."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:Seat a owl:Class;
  owl:versionInfo "3.0.0";
  owl:deprecated "false";
  rdfs:label "seat"@en;
  rdfs:comment "Identifies a seat."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:SeatAllocation a owl:Class;
  owl:versionInfo "3.0.0";
  rdfs:subClassOf org:Membership;
  owl:deprecated "false";
  rdfs:label "seat allocation"@en;
  rdfs:comment "Identifies an allocated seat assigned to a person being part of an organisation during a period of time."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:ProcessSubtype a owl:Class;
  owl:versionInfo "3.1.0";
  rdfs:subClassOf eli-dl:ProcessType;
  owl:deprecated "false";
  rdfs:label "process subtype"@en;
  rdfs:comment "Indicates a more precise purpose of the decision-making process (e.g. recast, codification, new legislative act...) on the top of the type of procedure (COD, APP, BUD)"@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:capacityActivity a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain epvoc:ForeseenCapacity;
  rdfs:range eli-dl:Process;
  owl:deprecated "false";
  rdfs:label "capacity activity"@en;
  rdfs:comment "Specifies the activity performed in a particular capacity."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:capacityOrganization a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain epvoc:ForeseenCapacity;
  rdfs:range org:Organization;
  owl:deprecated "false";
  rdfs:label "capacity organization"@en;
  rdfs:comment "Identifies the organization in which the capacity is held."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:capacityPerson a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain epvoc:ForeseenCapacity;
  rdfs:range org:Organization;
  owl:deprecated "false";
  rdfs:label "capacity person"@en;
  rdfs:comment "Identifies the person linked to a specific capacity."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:capacityRole a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain epvoc:ForeseenCapacity;
  rdfs:range epvoc:CapacityRole;
  owl:deprecated "false";
  rdfs:label "capacity role"@en;
  rdfs:comment "Defines the role associated with a capacity."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:hasRoom a owl:ObjectProperty;
  owl:versionInfo "1.0.0";
  rdfs:domain eli-dl:Activity;
  rdfs:range epvoc:Room;
  owl:deprecated "false";
  rdfs:label "has room"@en;
  rdfs:comment "Associates a resource with a room (physical or virtual)."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:hasSeat a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain epvoc:SeatAllocation;
  rdfs:range epvoc:Seat;
  owl:deprecated "false";
  rdfs:label "has seat"@en;
  rdfs:comment "Associates a seat allocation with a particular seat."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:hasSeatAllocation a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain foaf:Person;
  rdfs:range epvoc:SeatAllocation;
  owl:deprecated "false";
  rdfs:label "has seat allocation"@en;
  rdfs:comment "Associates a person with a seat allocation."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:hasSite a owl:ObjectProperty;
  owl:versionInfo "1.0.0";
  rdfs:range org:Site;
  owl:deprecated "false";
  rdfs:label "has site"@en;
  rdfs:comment "Identifies the site where a resource is located."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:inCapacityOf a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain eli-dl:Participation;
  rdfs:range epvoc:ForeseenCapacity;
  owl:deprecated "false";
  rdfs:label "in capacity of"@en;
  rdfs:comment "Indicates that a person is acting in a specific capacity."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:isAboutDirectoryCode a owl:ObjectProperty;
  owl:versionInfo "1.1.0";
  rdfs:domain eli:Work;
  rdfs:range skos:Concept;
  rdfs:subPropertyOf eli:is_about;
  owl:deprecated "false";
  rdfs:label "is about directory code"@en;
  rdfs:comment "Subproperty of eli:is_about identifying the directory code of a Work, pointing to dir-eu-legal-act concepts."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:isAboutSubjectMatter a owl:ObjectProperty;
  owl:versionInfo "1.1.0";
  rdfs:domain eli:Work;
  rdfs:range skos:Concept;
  rdfs:subPropertyOf eli:is_about;
  owl:deprecated "false";
  rdfs:label "is about subject matter"@en;
  rdfs:comment "Subproperty of eli:is_about identifying the subject matter of a Work."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:memberDuringParliamentaryTerm a owl:ObjectProperty;
  owl:versionInfo "1.0.0";
  rdfs:domain org:Membership;
  rdfs:range eli-dl:ParliamentaryTerm;
  rdfs:subPropertyOf org:organization;
  owl:deprecated "false";
  rdfs:label "member during parliamentary term"@en;
  rdfs:comment "Identifies the parliamentary term during which a person was a Member of the European Parliament."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:membershipClassification a owl:ObjectProperty;
  owl:versionInfo "1.0.0";
  rdfs:domain org:Membership;
  rdfs:range euvoc:CorporateBodyClassification;
  owl:deprecated "false";
  rdfs:label "membership classification"@en;
  rdfs:comment "Classification of an organisation linked to a membership."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:originalLanguage a owl:ObjectProperty;
  owl:versionInfo "1.0.0";
  rdfs:domain eli:Work;
  rdfs:range dcterms:LinguisticSystem;
  owl:deprecated "false";
  rdfs:label "original language"@en;
  rdfs:comment "Original language of a Work."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:politicalGroup a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:range skos:Concept;
  owl:deprecated "false";
  rdfs:label "political group"@en;
  rdfs:comment "Identifies a political group."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:processSubtype a owl:ObjectProperty;
  owl:versionInfo "3.1.0";
  rdfs:range skos:Concept;
  rdfs:subPropertyOf eli-dl:process_type;
  owl:deprecated "false";
  rdfs:label "process subtype"@en;
  rdfs:comment "Indicates a more precise purpose of the decision-making process (e.g. recast, codification, new legislative act...) on the top of the type of procedure (COD, APP, BUD)"@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:scheduledIn a owl:ObjectProperty;
  owl:versionInfo "1.1.0";
  rdfs:range eli-dl:Activity;
  owl:deprecated "false";
  rdfs:label "scheduled in"@en;
  rdfs:comment "Relates scheduled Activities."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:versionType a owl:ObjectProperty;
  owl:versionInfo "1.0.0";
