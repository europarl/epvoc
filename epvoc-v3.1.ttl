  rdfs:range skos:Concept;
  owl:deprecated "false";
  rdfs:label "version type"@en;
  rdfs:comment "Type of version of a Work."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:workHadParticipation a owl:ObjectProperty;
  owl:versionInfo "1.0.0";
  rdfs:domain eli:Work;
  rdfs:range eli:Participation;
  owl:deprecated "false";
  rdfs:label "work had participation"@en;
  rdfs:comment "Shortcut connecting a Work to participations in Activities related to it."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:isPartOfWorkType a owl:ObjectProperty;
  owl:versionInfo "3.0.0";
  rdfs:domain eli:Work;
  rdfs:range eli:Participation;
  owl:deprecated "false";
  rdfs:label "is part of worktype"@en;
  rdfs:comment "Identifies the type of Work of which the the Work Subdivision is part"@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

epvoc:valid a owl:ObjectProperty;
  owl:versionInfo "3.1.0";
  rdfs:domain skos:Concept;
  rdfs:range dcterms:PeriodOfTime;
  owl:deprecated "false";
  rdfs:label "valid"@en;
  rdfs:comment "States the period or condition in which a resource is valid."@en;
  rdfs:isDefinedBy <https://data.europarl.europa.eu/def/epvoc#> .

